{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimjooyoon/gooo-metaprogramming-lab/schema/report-v1.schema.json",
  "title": "Gooo metaprogramming lab report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case_id", "evaluation_scope", "decision", "decision_latency_ms", "baseline_id", "selected_id", "oracle_id", "selected_delta_vs_baseline", "oracle_gap", "requirements", "candidates"],
  "properties": {
    "schema": {"const": "gooo/metaprogramming-lab-report/v1"},
    "case_id": {"type": "string"},
    "evaluation_scope": {"type": "string", "enum": ["not_scored", "independent_oracle"]},
    "decision": {"$ref": "#/$defs/decision"},
    "decision_latency_ms": {"type": "number", "minimum": 0},
    "baseline_id": {"type": "string"},
    "selected_id": {"type": "string"},
    "oracle_id": {"type": "string"},
    "selected_delta_vs_baseline": {"type": "number", "minimum": -1, "maximum": 1},
    "oracle_gap": {"type": "number", "minimum": -1, "maximum": 1},
    "requirements": {"$ref": "#/$defs/requirements"},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["schema", "mode", "selected", "provider", "request_sha256"],
      "properties": {
        "schema": {"const": "gooo/typed-decision-receipt/v1"},
        "mode": {"type": "string"},
        "selected": {"type": "string"},
        "fallback_reason": {"type": "string"},
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "model_revision": {"type": "string"},
        "routing": {"type": "object"},
        "probabilities": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "answer_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "request_sha256": {"type": "string"}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["id", "ir_valid", "compiled", "deterministic", "replay_count", "generation_ms", "replay_ms", "compile_ms", "structural_completeness"],
      "properties": {
        "id": {"type": "string"},
        "ir_valid": {"type": "boolean"},
        "compiled": {"type": "boolean"},
        "deterministic": {"type": "boolean"},
        "ir_sha256": {"type": "string"},
        "generated_sha256": {"type": "string"},
        "replay_sha256": {"type": "string"},
        "replay_count": {"type": "integer", "minimum": 0},
        "generated_bytes": {"type": "integer", "minimum": 0},
        "generation_ms": {"type": "number", "minimum": 0},
        "replay_ms": {"type": "number", "minimum": 0},
        "compile_ms": {"type": "number", "minimum": 0},
        "structural_completeness": {"$ref": "#/$defs/coverage"},
        "error": {"type": "string"}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["satisfied", "total", "ratio"],
      "properties": {
        "satisfied": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "missing": {"type": "array", "items": {"type": "string"}}
      }
    },
    "requirements": {
      "type": "object",
      "required": ["entities", "activities"],
      "properties": {
        "entities": {"type": "array", "items": {"type": "string"}},
        "activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}}
      }
    },
    "activity": {
      "type": "object",
      "required": ["name", "inputs", "outputs"],
      "properties": {
        "name": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
