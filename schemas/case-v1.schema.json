{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimjooyoon/gooo-metaprogramming-lab/schema/case-v1.schema.json",
  "title": "Gooo metaprogramming lab case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "task", "package", "base_ir", "transformations", "fallback", "required", "behavioral_contract"],
  "properties": {
    "schema": {"const": "gooo/metaprogramming-lab-case/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "task": {"type": "string", "minLength": 1},
    "package": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "base_ir": {"$ref": "#/$defs/ir"},
    "transformations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "add_entities", "add_activities"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string", "minLength": 1},
          "add_entities": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"}},
          "add_activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}}
        }
      }
    },
    "fallback": {"type": "string", "default": "keep_current"},
    "required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "activities"],
      "properties": {
        "entities": {"type": "array", "items": {"type": "string"}},
        "activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}}
      }
    },
    "behavioral_contract": {"type": "string", "enum": ["not_scored", "independent_oracle"]}
  },
  "$defs": {
    "ir": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "activities"],
      "properties": {
        "entities": {"type": "array", "items": {"type": "string"}},
        "activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "inputs", "outputs"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
