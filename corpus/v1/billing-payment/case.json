{
  "schema": "gooo/metaprogramming-lab-case/v1",
  "id": "billing-payment-flow",
  "task": "결제 요청을 처리할 구조를 만든다. 주문과 결제 수단을 받아 결제를 승인하고, 결제 영수증을 만들고, 감사 기록을 남기는 단계가 구별되어야 한다.",
  "package": "billing",
  "base_ir": {
    "entities": ["Order", "PaymentMethod", "Payment"],
    "activities": [
      {"name": "PayOrder", "inputs": ["Order", "PaymentMethod"], "outputs": ["Payment"]}
    ]
  },
  "transformations": [
    {
      "id": "keep_current",
      "description": "현재 IR 구조를 그대로 유지한다. Order와 PaymentMethod를 받아 Payment를 반환하는 PayOrder 하나만 둔다.",
      "add_entities": [],
      "add_activities": []
    },
    {
      "id": "decompose_payment_flow",
      "description": "결제 승인, 영수증 생성, 감사 기록을 별도 엔티티와 명시적 입력·출력을 가진 활동으로 나눈다.",
      "add_entities": ["PaymentReceipt", "AuditRecord"],
      "add_activities": [
        {"name": "AuthorizePayment", "inputs": ["Order", "PaymentMethod"], "outputs": ["Payment"]},
        {"name": "CreatePaymentReceipt", "inputs": ["Payment"], "outputs": ["PaymentReceipt"]},
        {"name": "RecordPaymentAudit", "inputs": ["Payment", "PaymentReceipt"], "outputs": ["AuditRecord"]}
      ]
    }
  ],
  "fallback": "keep_current",
  "required": {
    "entities": ["Order", "PaymentMethod", "Payment", "PaymentReceipt", "AuditRecord"],
    "activities": [
      {"name": "PayOrder", "inputs": ["Order", "PaymentMethod"], "outputs": ["Payment"]},
      {"name": "AuthorizePayment", "inputs": ["Order", "PaymentMethod"], "outputs": ["Payment"]},
      {"name": "CreatePaymentReceipt", "inputs": ["Payment"], "outputs": ["PaymentReceipt"]},
      {"name": "RecordPaymentAudit", "inputs": ["Payment", "PaymentReceipt"], "outputs": ["AuditRecord"]}
    ]
  },
  "behavioral_contract": "not_scored"
}
